{
  "opencollection": "1.0.0",
  "info": {
    "name": "iconik Assets Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "App-ID",
      "value": "{{App-ID}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.iconik.io/API/search/v1/search/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number of results to return."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "The number of results per page."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Runs a search across assets and collections using full-text, metadata, and facet filters, with sorting and pagination supplied in the request body."
        }
      ]
    }
  ],
  "bundled": true
}